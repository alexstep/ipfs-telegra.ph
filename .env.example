# Optional defaults for your own deploy. Anything set here is baked into the
# public JavaScript bundle. Leave the token empty and paste it in the page
# settings instead — that value stays in this browser and is not committed.

# local | pinata | psa | kubo
VITE_PIN_PROVIDER=local

# Pinata upload API origin, or the base URL of an IPFS Pinning Service API.
# Pinata: https://api.pinata.cloud
# Pinata PSA: https://api.pinata.cloud/psa
VITE_PIN_ENDPOINT=

# JWT or bearer token. Prefer the settings panel over this variable.
VITE_PIN_TOKEN=

# Kubo HTTP API. Used by the "Kubo" provider and by "Pinning Service API"
# (the service pins a CID, so the files have to be added to a node first).
VITE_KUBO_API=

# Optional dedicated gateway, tried before the public list.
# Example: https://your-gateway.mypinata.cloud
VITE_IPFS_GATEWAY=
